{
  "name": "authflow-ai",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:api\"",
    "dev:client": "vite --port 3000",
    "dev:api": "node --import tsx scripts/dev-api.ts",
    "build": "tsc -b && vite build",
    "start:api": "node --import tsx scripts/dev-api.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.2",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-router": "^1.114.0",
    "openai": "^6.33.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.19",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vercel": "^32.3.0",
    "vite": "^6.2.2"
  }
}
